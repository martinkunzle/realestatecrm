{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "realestatecrm",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "closekey-crm-db",
      "database_id": "d1861f97-1817-4f65-9b37-0de19c97c400"
    }
  ],
  "vars": {
    "APP_URL": "https://realestatecrm.martin-kunzle.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
